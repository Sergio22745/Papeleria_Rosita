<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="view-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.papeleriarosita.controller.InventarioController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
    </padding>

    <!-- Encabezado del Módulo -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="module-header-box">
        <Label text="📦" styleClass="module-header-icon, icon-inventario"/>
        <VBox spacing="3.0">
            <Label text="Control de Inventario y Existencias" styleClass="module-header-title, title-inventario"/>
            <Label text="Supervisión de cantidades disponibles, alertas de reposición y registro de entradas físicas"
                   styleClass="section-desc-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>

    <!-- Tarjetas de Métricas / KPIs de Alerta -->
    <HBox spacing="16.0">
        <!-- 1. Total de Artículos -->
        <VBox alignment="CENTER_LEFT" spacing="4.0" styleClass="kpi-card, kpi-card-total" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="📦" styleClass="kpi-icon"/>
                <Label text="TOTAL PRODUCTOS" styleClass="kpi-title"/>
            </HBox>
            <Label fx:id="lblTotalItems" text="0" styleClass="kpi-number"/>
            <Label text="Artículos en catálogo" styleClass="kpi-subtitle"/>
        </VBox>

        <!-- 2. Alerta Stock Bajo -->
        <VBox alignment="CENTER_LEFT" spacing="4.0" styleClass="kpi-card, kpi-card-warning" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="⚠️" styleClass="kpi-icon"/>
                <Label text="STOCK BAJO" styleClass="kpi-title, kpi-title-warning"/>
            </HBox>
            <Label fx:id="lblTotalStockBajo" text="0" styleClass="kpi-number, kpi-number-warning"/>
            <Label text="Existencias menores o iguales al mínimo" styleClass="kpi-subtitle"/>
        </VBox>

        <!-- 3. Alerta Agotados -->
        <VBox alignment="CENTER_LEFT" spacing="4.0" styleClass="kpi-card, kpi-card-danger" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label text="⛔" styleClass="kpi-icon"/>
                <Label text="AGOTADOS" styleClass="kpi-title, kpi-title-danger"/>
            </HBox>
            <Label fx:id="lblTotalAgotados" text="0" styleClass="kpi-number, kpi-number-danger"/>
            <Label text="Sin unidades disponibles (0 existencias)" styleClass="kpi-subtitle"/>
        </VBox>
    </HBox>

    <Separator/>

    <!-- Barra de Filtros, Búsqueda y Acciones -->
    <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="toolbar-box">
        <TextField fx:id="txtBuscar" promptText="Buscar por producto, código o categoría..."
                   prefWidth="280.0" styleClass="text-input-field" onAction="#onBuscar"/>
        <Button text="🔍 Buscar" onAction="#onBuscar" styleClass="btn-secondary"/>
        <Button text="✕" onAction="#onLimpiarBusqueda" styleClass="btn-secondary-light"/>

        <Separator orientation="VERTICAL"/>

        <!-- Filtros Rápidos -->
        <Button fx:id="btnFiltroTodos" text="Todos" onAction="#onFiltroTodos"
                styleClass="filter-btn, filter-btn-active"/>
        <Button fx:id="btnFiltroBajoStock" text="⚠️ Stock Bajo" onAction="#onFiltroStockBajo"
                styleClass="filter-btn"/>
        <Button fx:id="btnFiltroAgotados" text="⛔ Agotados" onAction="#onFiltroAgotados"
                styleClass="filter-btn"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Botones de Acción Operativa -->
        <Button fx:id="btnEntradaFisica" text="➕ Entrada Física" onAction="#onRegistrarEntradaFisica"
                styleClass="btn-primary, btn-primary-inventario"/>
        <Button fx:id="btnModificarStockMin" text="⚙️ Stock Mínimo" onAction="#onModificarStockMinimo"
                disable="true" styleClass="btn-secondary"/>
        <Button fx:id="btnVerMovimientos" text="📜 Ver Movimientos" onAction="#onToggleVerMovimientos"
                styleClass="btn-secondary-light"/>
        <Button text="🔄" onAction="#cargarDatosInventario" styleClass="btn-secondary-light"/>
    </HBox>

    <!-- Tabla Principal de Existencias de Inventario -->
    <VBox spacing="8.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblInventario" VBox.vgrow="ALWAYS" prefHeight="280.0" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código"/>
                <TableColumn fx:id="colProducto" prefWidth="250.0" text="Nombre del Producto"/>
                <TableColumn fx:id="colCategoria" prefWidth="160.0" text="Categoría"/>
                <TableColumn fx:id="colStockActual" prefWidth="110.0" text="Existencias"/>
                <TableColumn fx:id="colStockMinimo" prefWidth="105.0" text="Stock Mínimo"/>
                <TableColumn fx:id="colEstadoAlerta" prefWidth="115.0" text="Alerta de Stock"/>
                <TableColumn fx:id="colUltimaActualizacion" prefWidth="140.0" text="Última Actualización"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <Label fx:id="lblMensajeEstado" text="Listo" styleClass="table-status-label"/>
    </VBox>

    <!-- Panel Plegable de Historial de Movimientos de Inventario -->
    <VBox fx:id="panelMovimientos" spacing="10.0" styleClass="movements-panel-card"
          visible="false" managed="false">

        <HBox alignment="CENTER_LEFT" spacing="12.0">
            <Label text="📜 Historial de Movimientos de Inventario" styleClass="movements-panel-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="(Auditoría de ENTRADAS físicas, SALIDAS por ventas y compras registradas con usuario responsable)"
                   styleClass="field-help-text"/>
        </HBox>

        <TableView fx:id="tblMovimientos" prefHeight="190.0" styleClass="custom-table">
            <columns>
                <TableColumn fx:id="colMovFecha" prefWidth="135.0" text="Fecha / Hora"/>
                <TableColumn fx:id="colMovCodigo" prefWidth="95.0" text="Código"/>
                <TableColumn fx:id="colMovProducto" prefWidth="210.0" text="Producto"/>
                <TableColumn fx:id="colMovTipo" prefWidth="95.0" text="Tipo"/>
                <TableColumn fx:id="colMovCantidad" prefWidth="80.0" text="Cantidad"/>
                <TableColumn fx:id="colMovMotivo" prefWidth="240.0" text="Motivo / Descripción"/>
                <TableColumn fx:id="colMovUsuario" prefWidth="130.0" text="Registrado Por"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
    </VBox>

</VBox>
