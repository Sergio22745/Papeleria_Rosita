<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.papeleriarosita.controller.SetupController"
           styleClass="root-pane">

    <VBox alignment="CENTER" maxWidth="460.0" spacing="16.0" styleClass="setup-card">
        <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0"/>
        </padding>

        <!-- Encabezado de identidad visual -->
        <VBox alignment="CENTER" spacing="4.0">
            <Label text="✿" styleClass="flower-icon"/>
            <HBox alignment="CENTER">
                <Label text="Papelería " styleClass="title-papeleria"/>
                <Label text="Rosita" styleClass="title-rosita"/>
            </HBox>
            <Label text="Configuración Inicial del Sistema" styleClass="subtitle-label"/>
        </VBox>

        <!-- Banner explicativo -->
        <VBox styleClass="setup-banner" spacing="4.0">
            <Label text="🌸 Configuración de Administradora" styleClass="field-label"/>
            <Label text="No se encontraron cuentas activas. Registra tus datos para inicializar el sistema con acceso de Administradora."
                   styleClass="setup-banner-text" wrapText="true"/>
        </VBox>

        <!-- Campo Nombre Completo -->
        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="Nombre completo" styleClass="field-label"/>
            <HBox styleClass="input-box" alignment="CENTER_LEFT">
                <TextField fx:id="txtNombre" promptText="Rosita"
                           styleClass="text-input-field" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Campo Correo Electrónico -->
        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="Correo electrónico" styleClass="field-label"/>
            <HBox styleClass="input-box" alignment="CENTER_LEFT">
                <TextField fx:id="txtCorreo" promptText="rosita@papeleriarosita.com"
                           styleClass="text-input-field" HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <!-- Campo Contraseña -->
        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="Contraseña (mínimo 6 caracteres)" styleClass="field-label"/>
            <HBox styleClass="password-box" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="txtContrasena" promptText="Ingresa tu contraseña"
                                   styleClass="password-input"/>
                    <TextField fx:id="txtContrasenaVisible" promptText="Ingresa tu contraseña"
                               styleClass="password-input" visible="false"/>
                </StackPane>
                <Button fx:id="btnToggleContrasena" text="👁" onAction="#onToggleContrasena"
                        styleClass="toggle-eye-btn" focusTraversable="false"/>
            </HBox>
        </VBox>

        <!-- Campo Confirmar Contraseña -->
        <VBox spacing="6.0" maxWidth="Infinity">
            <Label text="Confirmar contraseña" styleClass="field-label"/>
            <HBox styleClass="password-box" alignment="CENTER_LEFT">
                <StackPane HBox.hgrow="ALWAYS">
                    <PasswordField fx:id="txtConfirmar" promptText="Repite tu contraseña"
                                   styleClass="password-input"/>
                    <TextField fx:id="txtConfirmarVisible" promptText="Repite tu contraseña"
                               styleClass="password-input" visible="false"/>
                </StackPane>
                <Button fx:id="btnToggleConfirmar" text="👁" onAction="#onToggleConfirmar"
                        styleClass="toggle-eye-btn" focusTraversable="false"/>
            </HBox>
        </VBox>

        <!-- Botón para Registrar la Administradora -->
        <Button fx:id="btnRegistrar" text="CREAR CUENTA DE ADMINISTRADORA"
                onAction="#onRegistrarAdministradora"
                styleClass="login-button" maxWidth="Infinity"/>

        <!-- Enlace para volver al login -->
        <Button fx:id="btnVolver" text="← Volver al inicio de sesión"
                onAction="#onVolverAlLogin"
                styleClass="btn-volver-link"/>

        <!-- Mensajes de estado -->
        <Label fx:id="messageLabel" styleClass="message-label" wrapText="true"
               maxWidth="Infinity" visible="false" managed="false"/>
    </VBox>
</StackPane>
