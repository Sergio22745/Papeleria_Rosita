<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="view-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.papeleriarosita.controller.ProductosController">

    <padding>
        <Insets bottom="24.0" left="28.0" right="28.0" top="20.0"/>
    </padding>

    <!-- Encabezado del Módulo -->
    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="module-header-box">
        <Label text="📋" styleClass="module-header-icon, icon-productos"/>
        <VBox spacing="3.0">
            <Label text="Catálogo de Productos" styleClass="module-header-title, title-productos"/>
            <Label text="Administración de artículos, categorías y precios de venta fijados por Rosita"
                   styleClass="section-desc-text"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalProductos" text="Total catálogo: 0 productos" styleClass="header-date-badge"/>
    </HBox>

    <Separator/>

    <!-- Barra de Búsqueda y Acciones Rápidas -->
    <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="toolbar-box">
        <TextField fx:id="txtBuscar" promptText="Buscar producto por nombre o código..."
                   prefWidth="320.0" styleClass="text-input-field" onAction="#onBuscar"/>
        <Button text="🔍 Buscar" onAction="#onBuscar" styleClass="btn-secondary"/>
        <Button text="✕ Limpiar" onAction="#onLimpiarBusqueda" styleClass="btn-secondary-light"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnNuevo" text="➕ Nuevo Producto" onAction="#onNuevoProducto"
                styleClass="btn-primary, btn-primary-productos"/>
        <Button fx:id="btnEditar" text="✏️ Editar" onAction="#onEditarProducto" disable="true"
                styleClass="btn-secondary"/>
        <Button fx:id="btnCambiarEstado" text="⛔ Inactivar" onAction="#onCambiarEstadoActivo" disable="true"
                styleClass="btn-secondary-light"/>
        <Button text="🔄 Actualizar" onAction="#cargarProductos" styleClass="btn-secondary-light"/>
    </HBox>

    <!-- Área Principal: Tabla y Formulario Lateral -->
    <HBox spacing="18.0" VBox.vgrow="ALWAYS">

        <!-- Tabla de Productos -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS" styleClass="custom-table">
                <columns>
                    <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código"/>
                    <TableColumn fx:id="colNombre" prefWidth="240.0" text="Nombre del Producto"/>
                    <TableColumn fx:id="colCategoria" prefWidth="160.0" text="Categoría"/>
                    <TableColumn fx:id="colPrecio" prefWidth="120.0" text="Precio Venta"/>
                    <TableColumn fx:id="colStock" prefWidth="90.0" text="Stock"/>
                    <TableColumn fx:id="colEstado" prefWidth="95.0" text="Estado"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label fx:id="lblMensajeTabla" text="Listo" styleClass="table-status-label"/>
        </VBox>

        <!-- Formulario Lateral de Registro / Edición (desplegable) -->
        <VBox fx:id="formPanel" prefWidth="380.0" spacing="14.0" styleClass="side-form-card"
              visible="false" managed="false">

            <HBox alignment="CENTER_LEFT">
                <Label fx:id="lblTituloFormulario" text="Registrar Nuevo Producto"
                       styleClass="form-card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="✕" onAction="#onCancelarFormulario" styleClass="btn-icon-close"/>
            </HBox>

            <Separator/>

            <VBox spacing="6.0">
                <Label text="Código único:* (ej. CUAD-100, PEL-OSITO)" styleClass="field-label"/>
                <TextField fx:id="txtCodigo" promptText="Código o referencia" styleClass="text-input-field"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Nombre del producto:*" styleClass="field-label"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo del artículo" styleClass="text-input-field"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Categoría:*" styleClass="field-label"/>
                <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" promptText="Seleccionar categoría"
                          styleClass="combo-box-custom"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Precio de venta ($):*" styleClass="field-label"/>
                <TextField fx:id="txtPrecioVenta" promptText="0.00" styleClass="text-input-field"/>
                <Label fx:id="lblAvisoPrecio" text="Establecido exclusivamente por Rosita"
                       styleClass="field-help-text" visible="false" managed="false"/>
            </VBox>

            <!-- Stock mínimo inicial (solo visible al crear) -->
            <VBox fx:id="boxStockMinimo" spacing="6.0">
                <Label text="Stock mínimo para alerta de bajo stock:" styleClass="field-label"/>
                <TextField fx:id="txtStockMinimoInicial" text="5" promptText="5" styleClass="text-input-field"/>
                <Label text="Alerta cuando las existencias sean iguales o menores a este valor."
                       styleClass="field-help-text"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Descripción (opcional):" styleClass="field-label"/>
                <TextArea fx:id="txtDescripcion" promptText="Detalles adicionales, tamaño, presentación..."
                          prefRowCount="3" styleClass="text-input-field"/>
            </VBox>

            <CheckBox fx:id="chkActivo" text="Producto activo en el catálogo" selected="true"
                      styleClass="custom-checkbox"/>

            <Label fx:id="lblMensajeForm" wrapText="true" styleClass="form-error-label"/>

            <HBox spacing="10.0" alignment="CENTER_RIGHT">
                <Button text="Cancelar" onAction="#onCancelarFormulario" styleClass="btn-secondary-light"/>
                <Button fx:id="btnGuardar" text="Guardar Producto" onAction="#onGuardar"
                        styleClass="btn-primary, btn-primary-productos"/>
            </HBox>
        </VBox>

    </HBox>

</VBox>
